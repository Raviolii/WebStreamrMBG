        <script>
            (function () {
                const WRAP_SELECTOR   = '.search-results';                 // container of groups
                const GROUP_SELECTOR  = '.results-group';                  // each pane
                const BTN_SELECTOR    = '.search-filter [data-filter]';    // your pills

                function setActive(filter) {
                    document.querySelectorAll(BTN_SELECTOR).forEach(b => {
                        const isActive = b.dataset.filter === filter || (filter === 'all' && b.dataset.filter === 'all');
                        b.classList.toggle('active', isActive);
                        b.setAttribute('aria-selected', isActive ? 'true' : 'false');
                    });
                }

                function showGroup(filter, updateUrl = true) {
                    const wrap = document.querySelector(WRAP_SELECTOR);
                    if (!wrap) return;

                    // Show only the requested group. "all" shows the aggregated pane.
                    wrap.querySelectorAll(GROUP_SELECTOR).forEach(g => {
                        const key = g.getAttribute('data-group');
                        const shouldShow = (filter === 'all') ? (key === 'all') : (key === filter);
                        g.classList.toggle('d-none', !shouldShow);
                    });

                    setActive(filter);

                    if (updateUrl) {
                        const url = new URL(location.href);
                        url.searchParams.set('tab', filter);
                        history.replaceState(null, '', url);
                    }
                }

                function init() {
                    const urlTab = new URL(location.href).searchParams.get('tab');
                    const currentActive = document.querySelector(BTN_SELECTOR + '.active');
                    const initial = urlTab || currentActive?.dataset.filter || 'all';
                    showGroup(initial, false);

                    document.addEventListener('click', (e) => {
                        const btn = e.target.closest(BTN_SELECTOR);
                        if (!btn) return;
                        e.preventDefault();
                        showGroup(btn.dataset.filter, true);
                    });
                }

                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', init);
                } else {
                    init();
                }
            })();
        </script>


