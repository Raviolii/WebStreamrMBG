            const iframe  = document.getElementById('player-iframe');
            const meta    = document.getElementById('player-meta');
            const metaSuffix = document.getElementById('player-meta-suffix');
            const initialLanguageId = 1;

            // If there's no iframe (no links available), don't initialize player functionality
            if (!iframe) {
                return;
            }

            let clickTimer = null;
            let token = 0;
            let watchTimer = null;
            let lastMarkedKey = '';
            let markedOnceThisPage = false;
            const srcObserver = new MutationObserver(() => scheduleWatchMark());

            function swap(url){
                if (!iframe || !url || iframe.src === url) return;
                const myToken = ++token;
                clearTimeout(clickTimer);
                clickTimer = setTimeout(() => {
                    if (myToken !== token) return;
                    iframe.src = url;
                }, 120);
            }

            iframe.addEventListener('load', () => {
                scheduleWatchMark();
            });

            function activate(box){
                boxes.forEach(b => b.classList.remove('active'));
                box.classList.add('active');

                const url = box.dataset.playUrl;
                const provider = box.dataset.providerName || '';
                const lang = box.dataset.languageLabel || '';

                // Always load in iframe (RedirectController will handle redirect or show link page)
                swap(url);
                if (metaSuffix) metaSuffix.textContent = (lang ? lang + ' ' : '') + provider;
            }
            boxes.forEach(b => b.addEventListener('click', () => activate(b)));
            
            // Auto-select the first link-box for the default language
            // Priority: 1) Initial language ID from backend, 2) First available box
            let initial = null;
            
            if (initialLanguageId) {
                // Try to find the first box matching the initial language ID
                initial = boxes.find(b => 
                    b.dataset.languageId === String(initialLanguageId) && 
                    b.dataset.playUrl
                ) || null;
            }
            
            // Fallback to first available box if no language match found
            if (!initial) {
                initial = boxes.find(b => b.dataset.playUrl) || null;
            }
            
            if (initial) activate(initial);

            function scheduleWatchMark(){
                if (!meta || markedOnceThisPage) return;
                clearTimeout(watchTimer);
                const currentSrc = iframe?.src || '';
                const key = [
                    meta.dataset.seriesId, meta.dataset.seasonNo,
                    meta.dataset.episodeNo, meta.dataset.episodeId, currentSrc
                ].join(':');
                if (key && key === lastMarkedKey) return;

                watchTimer = setTimeout(() => {
                    if (markedOnceThisPage) return;
                    if (key && key === lastMarkedKey) return;
                    markWatched().then(ok => {
                        if (ok) {
                            lastMarkedKey = key;
                            markedOnceThisPage = true;
                            clearTimeout(watchTimer);
                            srcObserver.disconnect();
                        }
                    });
                }, (2*60*1000)); // 2 minutes
            }

            async function markWatched(){
                if (!meta || markedOnceThisPage) return false;
                const payload = {
                    series_id:  Number(meta.dataset.seriesId || 0),
                    season_no:  Number(meta.dataset.seasonNo || 0),
                    episode_no: Number(meta.dataset.episodeNo || 0),
                    episode_id: Number(meta.dataset.episodeId || 0),
                    seen: true
                };
                if (!payload.series_id || !payload.episode_id) return false;

                const csrf = document.querySelector('meta[name="csrf-token"]')?.content || '';
                const res = await fetch("/api/episodes/watched", {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': csrf,
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify(payload),
                    credentials: 'same-origin'
                });
                return res.ok;
            }

            if (iframe) {
                srcObserver.observe(iframe, { attributes: true, attributeFilter: ['src'] });
            }

