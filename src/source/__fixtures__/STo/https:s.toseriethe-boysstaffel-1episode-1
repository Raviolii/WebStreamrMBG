    // minimal, isolated toggle (no jQuery/Bootstrap dependency)
    (function () {
        const wraps = document.currentScript?.previousElementSibling?.previousElementSibling ? [document] : [document];
        const showMore = 'Mehr anzeigen';
        const showLess = 'Weniger anzeigen';
        const more = 'mehr';
        document.addEventListener('click', function (e) {
            const btn = e.target.closest('.chip-more');
            if (!btn) return;
            const id = btn.getAttribute('data-target');
            const root = document.getElementById(id);
            if (!root) return;

            const hidden = root.querySelector('.chips-hidden');
            if (!hidden) return;

            const expanded = btn.getAttribute('aria-expanded') === 'true';
            if (expanded) {
                hidden.classList.add('d-none');
                btn.setAttribute('aria-expanded', 'false');
                const c = btn.getAttribute('data-count') || '';
                btn.textContent = c ? `\u0026 ${c} ${more}` : showMore;
            } else {
                hidden.classList.remove('d-none');
                btn.setAttribute('aria-expanded', 'true');
                btn.textContent = showLess;
            }
        }, {passive: true});
    })();
